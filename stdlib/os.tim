read = (path: str) -> read_file(path) or! ""

write = (path: str, data: str) -> {
	write_file(path, data) or! { err "cannot write file" }
	ret 1
}

append = (path: str, data: str) -> {
	write_file(path, (read_file(path) or! "") + data) or! { err "cannot write file" }
	ret 1
}

exists = (path: str) -> {
	f := c.fopen(path, "rb")
	f == 0 { ret no }
	c.fclose(f)
	ret yes
}

rm = (path: str) -> c.remove(path) == 0

mv = (a: str, b: str) -> c.rename(a, b) == 0

env = (name: str) -> c.getenv(name) or! ""

clock = -> c.time(0)

sleep = ms -> c.usleep(ms * 1000)
