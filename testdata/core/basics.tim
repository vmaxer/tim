println("hello", 1 + 2, 0.1 + 0.2 == 0.3, 7 / 2, 2 ** 100, -2 ** 2)
println(10 / 0, [1, 2][5], {a: 1}["b"])
println(1 / 3 + 1 / 6, 3 * (1 / 3) == 1, sqrt(2), 1e20 as float64, (22 / 7) as float64)
println(yes, no, not yes, 3 < 5 < 7, 5 < 3 or 2 < 4, 0 or! 9, (10 / 0) or! "fallback")
println(6 & 3, 6 | 3, 6 ^ 3, 1 << 10, -1 >> 60, ~0, bit(5, 2), rotl(1, 4), rotr(16, 4), rotl(-1, 7))
println(17 % 5, -17 % 5, floor(-7 / 2), ceil(7 / 2), round(2.5), trunc(-2.7), abs(-3))
println(min(3, 1, 2), max([4, 9, 2]), gcd(12, 18), sum([1, 2, 3.5]), pow(2, 10))
fact(n) = n <= 1 { => 1 ~> n * fact(n - 1) }
println(fact(30))
