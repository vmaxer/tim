c.puts("hello from C")
println(c.strlen("héllo"), c.abs(-5), c.sqrt(2), c.atoi("42"), c.hypot(3, 4))
p = c.malloc(16)
println(type(p), p != 0)
write_i32(p, 0, -7)
write_f64(p, 8, 2.5)
write_u8(p, 4, 200)
println(read_i32(p, 0), read_f64(p, 8), read_u8(p, 0), read_u8(p, 4), read_i8(p, 4))
q = p + 8
println(read_f64(q, 0), q - p)
c.free(p)
c.printf("printf %d %s %.2f %c\n", 42, "str", 3.14159, 65)
buf = c.malloc(64)
c.snprintf(buf, 64, "%d-%d", 1, 2)
println(cstr(buf), c.strlen(buf))
c.free(buf)
println(c.getenv("TIM_NOPE_NOT_SET"), cstr(c.getenv("TIM_TEST")))
// direct calls: every kind of argument and result
println(c.labs(-5), c.sqrtf(2.25), c.fmax(-0.5, 1.5), c.floor(-2.5))
println(c.strtol("7fffffff", 0, 16), c.strtol("-80", 0, 16), c.strlen(c.strdup("x")), c.atof("0.1") == 0.1)
s = c.strdup("tim")
println(cstr(s), c.strcmp(s, "tim"), c.strncmp("abc", "abd", 3) < 0, cstr(c.strchr(s, 105)))
c.free(s)
println(c.pow(2, 0.5), c.fmod(7.5, 2), c.sqrt(-1), c.atan2(1, 1) * 4)
z = alloc(16)
c.memset(z, 255, 4)
println(read_u32(z, 0), read_i16(z, 0), c.memcmp(z, z, 4))
