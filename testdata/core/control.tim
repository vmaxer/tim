kind(n) = n {
    0 => "zero"
    1..<10 => "small"
    ~> "large"
}
sign(x) = {
    | x > 0 => 1
    | x < 0 => -1
    ~> 0
}
clamp(x, lo, hi) = {
    | x < lo => ret lo
    | x > hi => ret hi
    x
}
println(kind(0), kind(5), kind(50), sign(-3), sign(0), clamp(15, 0, 10), clamp(-1, 0, 10), clamp(4, 0, 10))
total := 0
@ i in 0..<100 {
    i % 2 == 0 { continue }
    i > 20 { break }
    total <- total + i
}
println(total)
n := 0
@ n < 5 { n += 1 }
println(n)
hits := 0
@ i in 1..=3 {
    @ j in 1..=3 {
        j == 2 { continue @1 }
        hits += 1
    }
}
println(hits)
x = if n > 3 { "big" } else { "small" }
println(x)
count := 0
@ ! 10 { count += 1 }
println(count)
loop(i, acc) = i == 0 { => acc ~> loop(i - 1, acc + i) }
println(loop(1000000, 0))
